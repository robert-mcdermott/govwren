{
  "pack": {
    "key": "iso-iec-42001",
    "kind": "framework",
    "title": "ISO/IEC 42001 AI management system",
    "version": "2023",
    "pack_version": "1.0.0",
    "publisher": "ISO/IEC (this pack is GovWren's own and is not published by ISO)",
    "source_url": "https://www.iso.org/standard/42001",
    "license": "The standard is copyrighted. This pack holds its clause and control numbers with labels and summaries in GovWren's own words.",
    "text_policy": "identifiers",
    "attribution": "The clause and Annex A numbers of ISO/IEC 42001:2023, each with a short label and a summary written for GovWren. None of the standard's wording is reproduced. Read the standard itself for what it requires."
  },
  "requirements": [
    {
      "code": "4",
      "title": "Context of the organization",
      "children": [
        {
          "code": "4.1",
          "title": "Organizational context",
          "text": "Work out the internal and external issues that bear on the AI management system, including the organization's role with each AI system."
        },
        {
          "code": "4.2",
          "title": "Interested parties",
          "text": "Identify who has a stake in the AI management system and what they need from it."
        },
        {
          "code": "4.3",
          "title": "Scope",
          "text": "Set and record the boundaries of the AI management system."
        },
        {
          "code": "4.4",
          "title": "The management system",
          "text": "Establish, run, maintain, and improve the AI management system."
        }
      ]
    },
    {
      "code": "5",
      "title": "Leadership",
      "children": [
        {
          "code": "5.1",
          "title": "Leadership commitment",
          "text": "Top management shows commitment to the AI management system."
        },
        {
          "code": "5.2",
          "title": "AI policy",
          "text": "Top management sets an AI policy suited to the organization's purpose."
        },
        {
          "code": "5.3",
          "title": "Roles and authorities",
          "text": "Responsibilities and authorities for AI are assigned and communicated."
        }
      ]
    },
    {
      "code": "6",
      "title": "Planning",
      "children": [
        {
          "code": "6.1.2",
          "title": "AI risk assessment",
          "text": "A defined, repeatable process identifies, analyzes, and evaluates AI risks."
        },
        {
          "code": "6.1.3",
          "title": "AI risk treatment",
          "text": "Treatment options are chosen, controls compared with Annex A, and a statement of applicability produced."
        },
        {
          "code": "6.1.4",
          "title": "AI system impact assessment",
          "text": "A process assesses the possible consequences of AI systems for individuals, groups, and society."
        },
        {
          "code": "6.2",
          "title": "AI objectives",
          "text": "Measurable AI objectives are set and planned for."
        },
        {
          "code": "6.3",
          "title": "Planning of changes",
          "text": "Changes to the management system are carried out in a planned way."
        }
      ]
    },
    {
      "code": "7",
      "title": "Support",
      "children": [
        {
          "code": "7.1",
          "title": "Resources",
          "text": "Resources needed for the management system are provided."
        },
        {
          "code": "7.2",
          "title": "Competence",
          "text": "People doing AI work are competent, and the evidence is kept."
        },
        {
          "code": "7.3",
          "title": "Awareness",
          "text": "People know the AI policy and their part in it."
        },
        {
          "code": "7.4",
          "title": "Communication",
          "text": "Internal and external communication about the management system is planned."
        },
        {
          "code": "7.5",
          "title": "Documented information",
          "text": "Required records are created, controlled, and kept."
        }
      ]
    },
    {
      "code": "8",
      "title": "Operation",
      "children": [
        {
          "code": "8.1",
          "title": "Operational planning and control",
          "text": "Processes needed to meet requirements are planned, controlled, and changed in a controlled way."
        },
        {
          "code": "8.2",
          "title": "Performing AI risk assessments",
          "text": "Risk assessments are done at planned intervals and on significant change."
        },
        {
          "code": "8.3",
          "title": "Implementing AI risk treatment",
          "text": "The risk treatment plan is carried out and its effectiveness checked."
        },
        {
          "code": "8.4",
          "title": "Performing impact assessments",
          "text": "Impact assessments are done at planned intervals and on significant change."
        }
      ]
    },
    {
      "code": "9",
      "title": "Performance evaluation",
      "children": [
        {
          "code": "9.1",
          "title": "Monitoring and measurement",
          "text": "What is monitored and measured, how, and when is decided, and results are evaluated."
        },
        {
          "code": "9.2",
          "title": "Internal audit",
          "text": "The management system is audited internally at planned intervals."
        },
        {
          "code": "9.3",
          "title": "Management review",
          "text": "Top management reviews the management system at planned intervals."
        }
      ]
    },
    {
      "code": "10",
      "title": "Improvement",
      "children": [
        {
          "code": "10.1",
          "title": "Continual improvement",
          "text": "The management system is continually improved."
        },
        {
          "code": "10.2",
          "title": "Nonconformity and corrective action",
          "text": "Nonconformities are dealt with, causes found, and corrective action taken."
        }
      ]
    },
