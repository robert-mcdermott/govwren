{
  "pack": {
    "key": "default-program",
    "kind": "program",
    "title": "GovWren default program",
    "pack_version": "1.2.0",
    "publisher": "The GovWren Authors",
    "license": "Apache-2.0",
    "description": "A complete, working program for a research organization: a staged intake form, a six-factor scoring model with four tiers, routing rules for each tier, and standard conditions. It is meant to be edited."
  },
  "forms": [
    {
      "key": "use_case_intake",
      "kind": "use_case",
      "title": "Request to use AI",
      "intro": "Tell us what you want to use AI for. Most requests take about five minutes. Your answers are saved as you go.",
      "sections": [
        {
          "key": "basics",
          "title": "The basics",
          "intro": "What you want to do, and where.",
          "questions": [
            {
              "key": "name",
              "type": "text",
              "label": "What will you use AI for?",
              "required": true,
              "maps_to": "name",
              "help": "A few words, such as: Summarize lab meeting notes."
            },
            {
              "key": "unit",
              "type": "unit",
              "label": "Which unit is this for?",
              "required": true,
              "maps_to": "org_unit_id"
            },
            {
              "key": "purpose",
              "type": "long_text",
              "label": "Describe it",
              "required": true,
              "maps_to": "purpose",
              "help": "What it will do, and the problem it helps with. Describe the data; do not paste any here."
            },
            {
              "key": "systems",
              "type": "systems",
              "label": "Which AI tool or model will you use?",
              "maps_to": "systems",
              "help": "Choose from the tools GovWren knows about. Leave this empty if yours is not listed, and name it below."
            },
            {
              "key": "other_tool",
              "type": "text",
              "label": "A tool that is not listed",
              "help": "Its name and, if you know it, the plan or edition."
            },
            {
              "key": "own_model",
              "type": "choice",
              "label": "Will you run or train a model yourselves?",
              "help": "Choose the first answer if you only use a tool or service as it comes.",
              "options": [
                {
                  "key": "no",
                  "label": "No, we use a tool or service as it is"
                },
                {
                  "key": "run",
                  "label": "Yes, we run an existing model on equipment or cloud we control"
                },
                {
                  "key": "fine_tune",
                  "label": "Yes, we fine-tune or adapt an existing model with our own data"
                },
                {
                  "key": "train",
                  "label": "Yes, we train a model from our own data"
                }
              ]
            },
            {
              "key": "stage",
              "type": "choice",
              "label": "How far along is this?",
              "required": true,
              "vocabulary": "stages",
              "maps_to": "stage"
            },
            {
              "key": "domain",
              "type": "choice",
              "label": "What kind of work is it?",
              "vocabulary": "domains",
              "maps_to": "domain"
            }
          ]
        },
        {
          "key": "people",
          "title": "People and decisions",
          "intro": "Who could be affected, and how much rides on it.",
          "questions": [
            {
              "key": "affected_groups",
              "type": "choices",
              "label": "Who could be affected by what it produces?",
              "required": true,
              "vocabulary": "affected_groups",
              "maps_to": "affected_groups"
            },
            {
              "key": "impact",
              "type": "choice",
              "label": "If it got something wrong, how serious could the effect on a person be?",
              "required": true,
              "options": [
                {
                  "key": "none",
                  "label": "No effect on anyone outside the team"
                },
                {
                  "key": "minor",
                  "label": "Minor, and easily corrected"
                },
                {
                  "key": "significant",
                  "label": "Significant",
                  "help": "It could affect someone's opportunities, standing, or access to a service."
                },
                {
                  "key": "serious",
                  "label": "Serious",
                  "help": "It could affect someone's health, safety, legal rights, or livelihood."
                }
              ]
            },
            {
              "key": "decision_role",
              "type": "choice",
              "label": "How will its output be used?",
              "required": true,
              "vocabulary": "decision_roles",
              "maps_to": "decision_role"
            },
            {
              "key": "autonomy",
              "type": "choice",
              "label": "Can it take actions by itself?",
              "required": true,
              "options": [
                {
                  "key": "output_only",
                  "label": "No. It only produces output for a person to read or use"
                },
                {
                  "key": "acts_with_approval",
                  "label": "Yes, and a person approves each action first"
                },
                {
                  "key": "acts_within_limits",
                  "label": "Yes, within set limits, and its actions can be undone"
                },
                {
                  "key": "acts_irreversibly",
                  "label": "Yes, and some of its actions would be hard to undo"
                }
              ]
            },
            {
              "key": "human_oversight",
              "type": "long_text",
              "label": "Who checks its output, and how, before anyone relies on it?",
              "required": true,
              "maps_to": "human_oversight"
            },
            {
              "key": "outputs_used_for",
              "type": "choices",
              "label": "Will its output be used for any of these?",
              "vocabulary": "outputs_used_for",
              "maps_to": "outputs_used_for"
            }
          ]
        },
        {
          "key": "data",
          "title": "Data",
          "intro": "What goes in, and where it goes.",
          "questions": [
            {
              "key": "data_class",
              "type": "data_class",
              "label": "What is the most sensitive class of data involved?",
              "required": true,
              "vocabulary": "data_classes",
              "maps_to": "data_class",
              "help": "If several kinds of data are involved, choose the most sensitive."
            },
            {
              "key": "data_categories",
              "type": "choices",
              "label": "Does it involve any of these kinds of data?",
              "vocabulary": "data_categories",
              "maps_to": "data_categories"
            },
            {
              "key": "exposure",
              "type": "choice",
              "label": "Where does the data go?",
              "required": true,
              "options": [
                {
                  "key": "own_equipment",
                  "label": "It stays on the organization's own equipment"
                },
                {
                  "key": "own_cloud",
                  "label": "The organization's own cloud tenant"
                },
                {
                  "key": "vendor_agreement",
                  "label": "A supplier, under an agreement that covers this data"
                },
                {
                  "key": "vendor_no_agreement",
                  "label": "A supplier, with no agreement that covers this data, or I am not sure"
                }
              ]
            },
            {
              "key": "reach",
              "type": "choice",
              "label": "How widely will it be used?",
              "required": true,
              "options": [
                {
                  "key": "team",
                  "label": "One person or one team"
                },
                {
                  "key": "one_unit",
                  "label": "One unit"
                },
                {
                  "key": "many_units",
                  "label": "Several units"
                },
                {
                  "key": "org_wide",
                  "label": "The whole organization, or the public"
                }
              ]
            }
          ]
        },
        {
          "key": "own_model_details",
          "title": "The model you run or train",
          "intro": "Because you will run or train a model yourselves, nobody else answers for it.",
          "show_when": {
            "field": "answers.own_model",
            "op": "in",
            "value": [
              "run",
              "fine_tune",
              "train"
            ]
          },
          "questions": [
            {
              "key": "model_source",
              "type": "text",
              "required": true,
              "label": "Which model is it, and where do its weights come from?",
              "help": "Its name and version, and the repository or supplier. If you are training from nothing, say so."
            },
            {
              "key": "model_license",
              "type": "text",
              "label": "What license is it under?",
              "help": "And anything the license does not allow, such as commercial use.",
              "show_when": {
                "field": "answers.own_model",
                "op": "in",
                "value": [
                  "run",
                  "fine_tune"
                ]
              }
            },
            {
              "key": "model_runs_on",
              "type": "text",
              "required": true,
              "label": "Where will it run?",
              "help": "The workstation, cluster, or cloud service, and who can reach it."
            },
            {
              "key": "training_data_class",
              "type": "data_class",
              "vocabulary": "data_classes",
              "required": true,
              "label": "What is the most sensitive class of data it will be trained or tuned on?",
              "help": "A model can reproduce what it was trained on, so it is treated as at least this sensitive.",
              "show_when": {
                "field": "answers.own_model",
                "op": "in",
                "value": [
                  "fine_tune",
                  "train"
                ]
              }
            },
            {
              "key": "model_sharing",
              "type": "choice",
              "required": true,
              "label": "Who will the model or its weights be shared with?",
              "options": [
                {
                  "key": "unit",
                  "label": "Nobody outside our unit"
                },
                {
                  "key": "organization",
                  "label": "Others in the organization"
                },
                {
                  "key": "collaborators",
                  "label": "Named collaborators elsewhere"
                },
                {
                  "key": "published",
                  "label": "It will be published"
                }
              ]
            }
          ]
        },
        {
          "key": "personal_data",
          "title": "Data about people",
          "intro": "Because data about people is involved.",
          "show_when": {
            "field": "answers.data_categories",
            "op": "contains_any",
            "value": [
              "personal",
              "health",
              "human_subjects",
              "genetic",
              "student"
            ]
          },
          "questions": [
            {
              "key": "deidentified",
              "type": "yes_no",
              "label": "Will the data be de-identified before the AI sees it?",
              "required": true
            },
            {
              "key": "minimum_necessary",
              "type": "yes_no",
              "label": "Will only the data needed for the purpose be used?",
              "required": true
            },
            {
              "key": "ethics_protocol",
              "type": "text",
              "label": "Ethics protocol number, if this is human-subjects research",
              "show_when": {
                "field": "answers.data_categories",
                "op": "contains",
                "value": "human_subjects"
              }
            }
          ]
        },
        {
          "key": "supplier",
          "title": "The supplier",
          "intro": "Because data goes to an outside supplier.",
          "show_when": {
            "field": "answers.exposure",
            "op": "in",
            "value": [
              "vendor_agreement",
              "vendor_no_agreement"
            ]
          },
          "questions": [
            {
              "key": "trains_on_inputs",
              "type": "choice",
              "label": "May the supplier use what is entered to train its models?",
              "required": true,
              "options": [
                {
                  "key": "no",
                  "label": "No"
                },
                {
                  "key": "yes",
                  "label": "Yes"
                },
                {
                  "key": "unknown",
                  "label": "I do not know"
                }
              ]
            },
            {
              "key": "agreement_reference",
              "type": "text",
              "label": "The agreement that covers this data, if there is one",
              "show_when": {
                "field": "answers.exposure",
                "op": "eq",
                "value": "vendor_agreement"
              },
              "help": "A contract or agreement number, or who holds it."
            }
          ]
        },
        {
          "key": "automation",
          "title": "Actions it can take",
          "intro": "Because it can act by itself.",
          "show_when": {
            "field": "answers.autonomy",
            "op": "in",
            "value": [
              "acts_with_approval",
              "acts_within_limits",
              "acts_irreversibly"
            ]
          },
          "questions": [
            {
              "key": "actions",
              "type": "long_text",
              "label": "What can it change, and where?",
              "required": true
            },
            {
              "key": "stop_mechanism",
              "type": "long_text",
              "label": "How does a person stop it or undo what it did?",
              "required": true
            },
            {
              "key": "acts_as",
              "type": "text",
              "label": "Which account or credentials does it act under?"
            }
          ]
        },
        {
          "key": "integrity",
          "title": "Publications and funding",
          "intro": "Because its output will be used in work that is published or submitted.",
          "show_when": {
            "field": "answers.outputs_used_for",
            "op": "contains_any",
            "value": [
              "publications",
              "grant_applications",
              "peer_review"
            ]
          },
          "questions": [
            {
              "key": "disclosure",
              "type": "yes_no",
              "label": "Will the use of AI be disclosed wherever the journal or funder requires it?",
              "required": true
            },
            {
              "key": "verification",
              "type": "long_text",
              "label": "How will its output be checked for accuracy and for invented references?",
              "required": true
            }
          ]
        }
      ]
    }
  ],
  "scoring_model": {
    "factors": [
      {
        "key": "impact",
        "label": "Impact on people",
        "levels": [
          "No effect on anyone outside the team",
          "Minor, easily corrected effects",
          "Could affect someone's opportunities, standing, or access to services",
          "Could affect health, safety, legal rights, or livelihood"
        ]
      },
      {
        "key": "decision",
        "label": "Decision role",
        "levels": [
          "Background or exploratory; nothing relies on it",
          "Informs a person, who decides independently",
          "A person usually accepts its recommendation",
          "Decides or acts without a person reviewing each case"
        ]
      },
      {
        "key": "autonomy",
        "label": "Autonomy",
        "levels": [
          "Produces output only",
          "Takes actions a person approves one by one",
          "Acts within set limits; actions can be undone",
          "Acts with effects that are hard to undo"
        ]
      },
      {
        "key": "sensitivity",
        "label": "Data sensitivity",
        "levels": [
          "Public data",
          "Internal data",
          "Protected data",
          "Restricted data"
        ]
      },
      {
        "key": "exposure",
        "label": "Data exposure",
        "levels": [
          "Stays on the organization's own equipment",
          "The organization's own cloud tenant",
          "A supplier, under an agreement that covers the data",
          "A supplier with no covering agreement, or one that may train on what is entered"
        ]
      },
      {
        "key": "reach",
        "label": "Reach",
        "levels": [
          "One person or one team",
          "One unit",
          "Several units, or people outside the team are affected",
          "The whole organization, or the public"
        ]
      }
    ],
    "contributions": [
      {
        "factor": "impact",
        "level": 1,
        "when": {
          "field": "answers.impact",
          "op": "eq",
          "value": "minor"
        },
        "reason": "A mistake could have a minor, easily corrected effect on someone."
      },
      {
        "factor": "impact",
        "level": 2,
        "when": {
          "field": "answers.impact",
          "op": "eq",
          "value": "significant"
        },
        "reason": "A mistake could affect someone's opportunities, standing, or access to a service."
      },
      {
        "factor": "impact",
        "level": 3,
        "when": {
          "field": "answers.impact",
          "op": "eq",
          "value": "serious"
        },
        "reason": "A mistake could affect someone's health, safety, legal rights, or livelihood."
      },
      {
        "factor": "decision",
        "level": 1,
        "when": {
          "field": "answers.decision_role",
          "op": "eq",
          "value": "informs"
        },
        "reason": "Its output informs a person, who decides independently."
      },
      {
        "factor": "decision",
        "level": 2,
        "when": {
          "field": "answers.decision_role",
          "op": "eq",
          "value": "recommends"
        },
        "reason": "A person usually accepts what it recommends."
      },
      {
        "factor": "decision",
        "level": 3,
        "when": {
          "field": "answers.decision_role",
          "op": "eq",
          "value": "decides"
        },
        "reason": "It decides or acts without a person reviewing each case."
      },
      {
        "factor": "autonomy",
        "level": 1,
        "when": {
          "field": "answers.autonomy",
          "op": "eq",
          "value": "acts_with_approval"
        },
        "reason": "It takes actions, each approved by a person first."
      },
      {
        "factor": "autonomy",
        "level": 2,
        "when": {
          "field": "answers.autonomy",
          "op": "eq",
          "value": "acts_within_limits"
        },
        "reason": "It acts by itself within set limits."
      },
      {
        "factor": "autonomy",
        "level": 3,
        "when": {
          "field": "answers.autonomy",
          "op": "eq",
          "value": "acts_irreversibly"
        },
        "reason": "It acts by itself, and some actions would be hard to undo."
      },
      {
        "factor": "sensitivity",
        "level": 1,
        "when": {
          "field": "answers.data_class",
          "op": "eq",
          "value": "internal"
        },
        "reason": "The most sensitive data involved is Internal."
      },
      {
        "factor": "sensitivity",
        "level": 2,
        "when": {
          "field": "answers.data_class",
          "op": "eq",
          "value": "protected"
        },
        "reason": "The most sensitive data involved is Protected."
      },
      {
        "factor": "sensitivity",
        "level": 3,
        "when": {
          "field": "answers.data_class",
          "op": "eq",
          "value": "restricted"
        },
        "reason": "The most sensitive data involved is Restricted."
      },
      {
        "factor": "exposure",
        "level": 1,
        "when": {
          "field": "answers.exposure",
          "op": "eq",
          "value": "own_cloud"
        },
        "reason": "Data goes to the organization's own cloud tenant."
      },
      {
        "factor": "exposure",
        "level": 2,
        "when": {
          "field": "answers.exposure",
          "op": "eq",
          "value": "vendor_agreement"
        },
        "reason": "Data goes to a supplier, under an agreement that covers it."
      },
      {
        "factor": "exposure",
        "level": 3,
        "when": {
          "field": "answers.exposure",
          "op": "eq",
          "value": "vendor_no_agreement"
        },
        "reason": "Data goes to a supplier with no agreement known to cover it."
      },
      {
        "factor": "exposure",
        "level": 3,
        "when": {
          "field": "answers.trains_on_inputs",
          "op": "eq",
          "value": "yes"
        },
        "reason": "The supplier may use what is entered to train its models."
      },
      {
        "factor": "reach",
        "level": 1,
        "when": {
          "field": "answers.reach",
          "op": "eq",
          "value": "one_unit"
        },
        "reason": "It will be used across one unit."
      },
      {
        "factor": "reach",
        "level": 2,
        "when": {
          "field": "answers.reach",
          "op": "eq",
          "value": "many_units"
        },
        "reason": "It will be used across several units."
      },
      {
        "factor": "reach",
        "level": 2,
        "when": {
          "field": "answers.affected_groups",
          "op": "contains_any",
          "value": [
            "staff",
            "students",
            "participants",
            "patients"
          ]
        },
        "reason": "People outside the team are affected by what it produces."
      },
      {
        "factor": "reach",
        "level": 3,
        "when": {
          "field": "answers.reach",
          "op": "eq",
          "value": "org_wide"
        },
        "reason": "It will be used across the whole organization, or by the public."
      },
      {
        "factor": "reach",
        "level": 3,
        "when": {
          "field": "answers.affected_groups",
          "op": "contains",
          "value": "public"
        },
        "reason": "The public is affected by what it produces."
      }
    ],
    "tiers": [
      {
        "level": 1,
        "key": "minimal",
        "label": "Minimal",
        "min": 0,
        "description": "Everyday use with little that can go wrong."
      },
      {
        "level": 2,
        "key": "moderate",
        "label": "Moderate",
        "min": 5,
        "description": "Some sensitivity; a focused check is enough."
      },
      {
        "level": 3,
        "key": "high",
        "label": "High",
        "min": 9,
        "description": "Real potential for harm; full review."
      },
      {
        "level": 4,
        "key": "critical",
        "label": "Critical",
        "min": 13,
        "description": "Serious potential for harm; full review and named risk acceptance."
      }
    ],
    "floors": [
      {
        "tier": 3,
        "when": {
          "field": "answers.impact",
          "op": "eq",
          "value": "serious"
        },
        "reason": "A mistake could seriously affect a person, so it is reviewed as at least High."
      },
      {
        "tier": 3,
        "when": {
          "all": [
            {
              "field": "answers.data_class",
              "op": "eq",
              "value": "restricted"
            },
            {
              "field": "answers.exposure",
              "op": "eq",
              "value": "vendor_no_agreement"
            }
          ]
        },
        "reason": "Restricted data would go to a supplier with no covering agreement, so it is reviewed as at least High."
      },
      {
        "tier": 3,
        "when": {
          "field": "answers.autonomy",
          "op": "eq",
          "value": "acts_irreversibly"
        },
        "reason": "It can take actions that are hard to undo, so it is reviewed as at least High."
      },
      {
        "tier": 3,
        "when": {
          "all": [
            {
              "field": "answers.decision_role",
              "op": "eq",
              "value": "decides"
            },
            {
              "field": "answers.affected_groups",
              "op": "contains_any",
              "value": [
                "staff",
                "students",
                "participants",
                "patients",
                "public"
              ]
            }
          ]
        },
        "reason": "It decides about people without a person reviewing each case, so it is reviewed as at least High."
      },
      {
        "tier": 2,
        "when": {
          "field": "answers.training_data_class",
          "op": "in",
          "value": [
            "protected",
            "restricted"
          ]
        },
        "reason": "A model trained on Protected or Restricted data can reproduce it, so it is reviewed as at least Moderate."
      },
      {
        "tier": 3,
        "when": {
          "all": [
            {
              "field": "answers.training_data_class",
              "op": "eq",
              "value": "restricted"
            },
            {
              "field": "answers.model_sharing",
              "op": "in",
              "value": [
                "collaborators",
                "published"
              ]
            }
          ]
        },
        "reason": "A model trained on Restricted data would leave the organization, so it is reviewed as at least High."
      }
    ],
    "stops": [
      {
        "key": "restricted_data_trained_on",
        "when": {
          "all": [
            {
              "field": "answers.data_class",
              "op": "eq",
              "value": "restricted"
            },
            {
              "field": "answers.trains_on_inputs",
              "op": "eq",
              "value": "yes"
            }
          ]
        },
        "reason": "Restricted data may not be entered into a system whose supplier may train on it."
      },
      {
        "key": "peer_review",
        "when": {
          "field": "answers.outputs_used_for",
          "op": "contains",
          "value": "peer_review"
        },
        "reason": "Generative AI may not be used to carry out confidential peer review."
      },
      {
        "key": "automated_decisions_about_people",
        "when": {
          "all": [
            {
              "field": "answers.decision_role",
              "op": "eq",
              "value": "decides"
            },
            {
              "field": "answers.outputs_used_for",
              "op": "contains",
              "value": "decisions_about_people"
            }
          ]
        },
        "reason": "Decisions about people, such as admission, hiring, or discipline, may not be fully automated."
      }
    ]
  },
  "review": {
    "condition_templates": [
      {
        "key": "check_outputs",
        "text": "Check every output for accuracy before relying on it or passing it on.",
        "kind": "ongoing"
      },
      {
        "key": "stay_within_data",
        "text": "Use it only with the kinds of data described in this request. Declare a change before using anything more sensitive.",
        "kind": "ongoing"
      },
      {
        "key": "no_restricted_data",
        "text": "Do not enter Restricted data.",
        "kind": "ongoing"
      },
      {
        "key": "declare_changes",
        "text": "Declare a change before using a different tool or model, or using it for a new purpose.",
        "kind": "ongoing"
      },
      {
        "key": "disclose_ai_use",
        "text": "Say that AI was used wherever a journal, funder, or publisher requires it.",
        "kind": "ongoing"
      },
      {
        "key": "verify_references",
        "text": "Check every reference, quotation, and figure it produces against the source.",
        "kind": "ongoing"
      },
      {
        "key": "no_peer_review",
        "text": "Do not use it to review manuscripts or applications given to you in confidence.",
        "kind": "ongoing"
      },
      {
        "key": "deidentify_first",
        "text": "Remove identifiers from data about people before the AI sees it.",
        "kind": "before_use"
      },
      {
        "key": "agreement_in_place",
        "text": "Have an agreement in place that covers this data before any of it goes to the supplier.",
        "kind": "before_use"
      },
      {
        "key": "ethics_amendment",
        "text": "Have the use of AI approved under the ethics protocol before using it with participant data.",
        "kind": "before_use"
      },
      {
        "key": "human_reviews_each",
        "text": "A named person reviews each output before it affects anyone.",
        "kind": "ongoing"
      },
      {
        "key": "stop_mechanism_tested",
        "text": "Show that a person can stop it and undo what it did.",
        "kind": "before_use"
      },
      {
        "key": "security_review_findings",
        "text": "Close the findings of the security review.",
        "kind": "by_date",
        "due_days": 30
      },
      {
        "key": "report_incidents",
        "text": "Report anything that goes wrong, including near misses, within two working days.",
        "kind": "ongoing"
      },
      {
        "key": "register_model",
        "kind": "before_use",
        "text": "Record the model in the inventory, with its source, its license, and the datasets it was trained on."
      },
      {
        "key": "weights_stay_put",
        "kind": "ongoing",
        "text": "Keep the weights where the request says they will be. Declare a change before sharing them further."
      }
    ],
    "rules": [
      {
        "key": "everyone",
        "name": "Every approved use",
        "when": {},
        "then": {
          "conditions": [
            "check_outputs",
            "stay_within_data",
            "declare_changes",
            "report_incidents"
          ]
        }
      },
      {
        "key": "minimal",
        "name": "Minimal tier: approved by rule",
        "when": {
          "field": "tier",
          "op": "eq",
          "value": 1
        },
        "then": {
          "auto_approve": true,
          "cadence_months": 36
        }
      },
      {
        "key": "moderate",
        "name": "Moderate tier: governance decides",
        "when": {
          "field": "tier",
          "op": "eq",
          "value": 2
        },
        "then": {
          "authority": "governance",
          "due_days": 5,
          "cadence_months": 24
        }
      },
      {
        "key": "high",
        "name": "High tier: full review",
        "when": {
          "field": "tier",
          "op": "eq",
          "value": 3
        },
        "then": {
          "require": [
            "privacy",
            "security"
          ],
          "authority": "committee",
          "due_days": 15,
          "cadence_months": 12
        }
      },
      {
        "key": "critical",
        "name": "Critical tier: full review and risk acceptance",
        "when": {
          "field": "tier",
          "op": "gte",
          "value": 4
        },
        "then": {
          "require": [
            "privacy",
            "security",
            "legal"
          ],
          "authority": "committee_with_acceptance",
          "due_days": 30,
          "cadence_months": 6
        }
      },
      {
        "key": "human-subjects",
        "name": "Human-subjects research data",
        "when": {
          "field": "answers.data_categories",
          "op": "contains",
          "value": "human_subjects"
        },
        "then": {
          "require": [
            "ethics"
          ]
        }
      },
      {
        "key": "health-information",
        "name": "Health information",
        "when": {
          "field": "answers.data_categories",
          "op": "contains",
          "value": "health"
        },
        "then": {
          "require": [
            "privacy"
          ]
        }
      },
      {
        "key": "no-agreement",
        "name": "A supplier with no covering agreement",
        "when": {
          "field": "answers.exposure",
          "op": "eq",
          "value": "vendor_no_agreement"
        },
        "then": {
          "require": [
            "legal"
          ]
        }
      },
      {
        "key": "patients",
        "name": "Patients are affected",
        "when": {
          "field": "answers.affected_groups",
          "op": "contains",
          "value": "patients"
        },
        "then": {
          "require": [
            "clinical_safety"
          ]
        }
      },
      {
        "key": "acts-alone",
        "name": "It acts by itself",
        "when": {
          "field": "answers.autonomy",
          "op": "in",
          "value": [
            "acts_within_limits",
            "acts_irreversibly"
          ]
        },
        "then": {
          "require": [
            "security",
            "architecture"
          ]
        }
      },
      {
        "key": "publications",
        "name": "Publications and funding applications",
        "when": {
          "field": "answers.outputs_used_for",
          "op": "contains_any",
          "value": [
            "publications",
            "grant_applications"
          ]
        },
        "then": {
          "require": [
            "integrity"
          ],
          "conditions": [
            "disclose_ai_use",
            "verify_references"
          ]
        }
      },
      {
        "key": "internal-data-only",
        "name": "Public or internal data only",
        "when": {
          "field": "answers.data_class",
          "op": "in",
          "value": [
            "public",
            "internal"
          ]
        },
        "then": {
          "conditions": [
            "no_restricted_data"
          ]
        }
      },
      {
        "key": "own-model",
        "name": "A model the organization runs or trains itself",
        "when": {
          "field": "answers.own_model",
          "op": "in",
          "value": [
            "run",
            "fine_tune",
            "train"
          ]
        },
        "then": {
          "require": [
            "security"
          ],
          "conditions": [
            "register_model"
          ]
        }
      },
      {
        "key": "trained-on-sensitive-data",
        "name": "A model trained on Protected or Restricted data",
        "when": {
          "field": "answers.training_data_class",
          "op": "in",
          "value": [
            "protected",
            "restricted"
          ]
        },
        "then": {
          "require": [
            "data_stewardship"
          ],
          "conditions": [
            "weights_stay_put"
          ]
        }
      }
    ]
  }
}
