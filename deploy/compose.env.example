# Copy to deploy/.env and fill in. Keep deploy/.env out of version control.

# The https address people will use, with no path.
GOVWREN_BASE_URL=https://ai.example.org

# A long random password for the database. Make one with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Server processes. One for each processor core, up to four, is a sensible start.
GOVWREN_WORKERS=2

# The first administrator, created on the first start and ignored afterwards. The password
# needs at least 12 characters. Remove these three lines once you have signed in.
GOVWREN_ADMIN_EMAIL=you@example.org
GOVWREN_ADMIN_NAME=Your Name
GOVWREN_ADMIN_PASSWORD=
